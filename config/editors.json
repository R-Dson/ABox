{
  "editors": {
    "opencode": {
      "version": "1.2.16",
      "install_cmd": "npm install -g opencode-ai@{version}",
      "cmd_name": "opencode"
    },
    "claude": {
      "version": "2.1.68",
      "install_cmd": "npm install -g @anthropic-ai/claude-code@{version}",
      "cmd_name": "claude"
    },
    "aider": {
      "version": "0.86.2",
      "install_cmd": "uv tool install aider-chat@{version}",
      "cmd_name": "aider"
    },
    "copilot": {
      "version": "0.0.421",
      "install_cmd": "npm install -g @github/copilot@{version}",
      "cmd_name": "copilot"
    },
    "vibe": {
      "version": "2.3.0",
      "install_cmd": "uv tool install mistral-vibe@{version}",
      "cmd_name": "vibe"
    },
    "goose": {
      "version": "1.26.1",
      "install_cmd": "curl -fsSL https://github.com/block/goose/releases/download/stable/download_cli.sh | GOOSE_VERSION={version} CONFIGURE=false bash",
      "cmd_name": "goose"
    },
    "codex": {
      "version": "0.107.0",
      "install_cmd": "npm i -g @openai/codex@{version}",
      "cmd_name": "codex"
    },
    "gemini": {
      "version": "0.32.1",
      "install_cmd": "npm install -g @google/gemini-cli@{version}",
      "cmd_name": "gemini"
    },
    "cursor": {
      "version": "0.5.8",
      "install_cmd": "curl https://cursor.com/install -fsS | bash && mv /root/.local/bin/agent /usr/local/bin/cursor",
      "cmd_name": "cursor"
    }
  }
}