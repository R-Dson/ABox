#!/bin/bash

# --- Runtime Detection ---
detect_runtime() {
    # Check for explicit override
    if [[ -n "$ABOX_RUNTIME" ]]; then
        if command -v "$ABOX_RUNTIME" >/dev/null 2>&1 && "$ABOX_RUNTIME" info >/dev/null 2>&1; then
            echo "$ABOX_RUNTIME"
            return 0
        fi
        echo "ERROR: Specified runtime '$ABOX_RUNTIME' is not available or healthy." >&2
        return 1
    fi

    # Prefer Docker
    if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
        echo "docker"
        return 0
    fi

    # Fallback to Podman
    if command -v podman >/dev/null 2>&1 && podman info >/dev/null 2>&1; then
        echo "podman"
        return 0
    fi

    echo "ERROR: No healthy container runtime found (Docker or Podman)." >&2
    echo "Ensure your container engine is running and accessible." >&2
    return 1
}

# --- Editor Mapping ---
# Returns: image_tag|binary_command|config_path|env_vars
get_editor_info() {
    local editor=$1
    case "$editor" in
        claude)   echo "ghcr.io/r-dson/abox:claude|claude|.claude|ANTHROPIC_API_KEY" ;;
        aider)    echo "ghcr.io/r-dson/abox:aider|aider|.aider.conf.yml|OPENAI_API_KEY,ANTHROPIC_API_KEY" ;;
        copilot)  echo "ghcr.io/r-dson/abox:copilot|copilot|.copilot|GITHUB_TOKEN" ;;
        vibe)     echo "ghcr.io/r-dson/abox:vibe|vibe|.vibe|" ;;
        goose)    echo "ghcr.io/r-dson/abox:goose|goose|.config/goose|" ;;
        codex)    echo "ghcr.io/r-dson/abox:codex|codex|.codex|" ;;
        gemini)   echo "ghcr.io/r-dson/abox:gemini|gemini|.gemini|GOOGLE_API_KEY" ;;
        cursor)   echo "ghcr.io/r-dson/abox:cursor|cursor|.cursor|" ;;
        opencode|*) echo "ghcr.io/r-dson/abox:opencode|opencode|.config/opencode|" ;;
    esac
}

# --- Argument Parsing ---
CLI_EDITOR=""
SET_DEFAULT=""
POSITIONAL_ARGS=()
ABX_CONF="$HOME/.config/abx.conf"

while [[ $# -gt 0 ]]; do
    case $1 in
        --editor)
            CLI_EDITOR="$2"
            shift 2
            ;;
        --editor=*)
            CLI_EDITOR="${1#*=}"
            shift
            ;;
        --default-editor)
            SET_DEFAULT="$2"
            shift 2
            ;;
        --default-editor=*)
            SET_DEFAULT="${1#*=}"
            shift
            ;;
        *)
            POSITIONAL_ARGS+=("$1")
            shift
            ;;
    esac
done

# Handle --default-editor persistence
if [[ -n "$SET_DEFAULT" ]]; then
    mkdir -p "$(dirname "$ABX_CONF")"
    echo "EDITOR=$SET_DEFAULT" > "$ABX_CONF"
    echo "Default editor set to: $SET_DEFAULT"
    # If no other actions, exit
    if [[ ${#POSITIONAL_ARGS[@]} -eq 0 && -z "$CLI_EDITOR" ]]; then
        exit 0
    fi
fi

# Restore positional args
set -- "${POSITIONAL_ARGS[@]}"

# --- Priority Resolution Top Down ---
# --editor flag
# ABOX_EDITOR environment variable
# ~/.config/abx.conf
# Default to opencode
EDITOR_NAME="$CLI_EDITOR"
[[ -z "$EDITOR_NAME" ]] && EDITOR_NAME="$ABOX_EDITOR"
if [[ -z "$EDITOR_NAME" && -f "$ABX_CONF" ]]; then
    EDITOR_NAME=$(grep "^EDITOR=" "$ABX_CONF" | cut -d= -f2)
fi
[[ -z "$EDITOR_NAME" ]] && EDITOR_NAME="opencode"

# --- Resolve Editor Info ---
IFS='|' read -r IMAGE_NAME COMMAND_NAME CONFIG_REL_PATH ENV_VAR_NAMES <<< "$(get_editor_info "$EDITOR_NAME")"

# --- Runtime & Path Setup ---
CONTAINER_RUNTIME=$(detect_runtime) || exit 1
HOST_UID=${HOST_UID:-$(id -u)}
HOST_GID=${HOST_GID:-$(id -g)}

# Target Directory Resolution
TARGET_DIR="."
if [[ $# -gt 0 ]] && [[ -d "$1" ]]; then
    TARGET_DIR="$1"
    shift
fi
TARGET_DIR=$(cd "$TARGET_DIR" && pwd)

# Host Paths
HOST_CONFIG_PATH="$HOME/$CONFIG_REL_PATH"
HOST_SHARE_PATH="$HOME/.local/share/abox/$EDITOR_NAME"

# Ensure host paths exist
if [[ "$CONFIG_REL_PATH" == *.* ]]; then
    # Likely a file or hidden dir, be careful
    if [[ "$EDITOR_NAME" == "aider" ]]; then
        # Aider uses a file, don't create it as a directory
        mkdir -p "$(dirname "$HOST_CONFIG_PATH")"
        touch "$HOST_CONFIG_PATH"
    else
        mkdir -p "$HOST_CONFIG_PATH"
    fi
else
    mkdir -p "$HOST_CONFIG_PATH"
fi
mkdir -p "$HOST_SHARE_PATH"

# --- Ephemeral Volume Setup (Airlock) ---
AUTH_VOL="abox-auth-$(date +%s)"
SHARE_VOL="abox-share-$(date +%s)"
$CONTAINER_RUNTIME volume create "$AUTH_VOL" > /dev/null
$CONTAINER_RUNTIME volume create "$SHARE_VOL" > /dev/null

cleanup() {
    $CONTAINER_RUNTIME volume rm "$AUTH_VOL" "$SHARE_VOL" > /dev/null 2>&1
}
trap cleanup EXIT

# Airlock Copy Logic
AIRLOCK_CP_CONFIG="cp -r /config_src/. /config_dest/"
if [[ -f "$HOST_CONFIG_PATH" ]]; then
    AIRLOCK_CP_CONFIG="cp /config_src /config_dest/$(basename "$CONFIG_REL_PATH")"
fi

$CONTAINER_RUNTIME run --rm \
    -v "$HOST_CONFIG_PATH:/config_src:ro,z" \
    -v "$HOST_SHARE_PATH:/share_src:ro,z" \
    -v "$AUTH_VOL:/config_dest" \
    -v "$SHARE_VOL:/share_dest" \
    alpine sh -c "
        $AIRLOCK_CP_CONFIG && 
        cp -r /share_src/. /share_dest/ && 
        chmod -R u+rwX /config_dest /share_dest && 
        chown -R $HOST_UID:$HOST_GID /config_dest /share_dest
    "

# --- 8. Launch Sandbox ---
# Interactive Flags
INTERACTIVE_FLAGS="-i"
if [[ -t 0 ]] || [[ "$EDITOR_NAME" == "claude" ]] || [[ "$EDITOR_NAME" == "aider" ]]; then
    INTERACTIVE_FLAGS="-it"
fi

# Map Environment Variables
ENV_FLAGS=""
IFS=',' read -ra ADDR <<< "$ENV_VAR_NAMES"
for env_var in "${ADDR[@]}"; do
    if [[ -n "${!env_var}" ]]; then
        ENV_FLAGS="$ENV_FLAGS -e $env_var"
    fi
done

# Resolve Guest Config Mounts
GUEST_CONFIG_PATH="/home/agent/$CONFIG_REL_PATH"
GUEST_SHARE_PATH="/home/agent/.local/share/$EDITOR_NAME"

if [[ "$EDITOR_NAME" == "opencode" ]]; then
    # Backward compatibility/spec for opencode
    CONFIG_MOUNTS="-v $AUTH_VOL:/home/agent/.config/opencode -v $AUTH_VOL:/home/agent/.opencode"
    
    # Add Global Claude-compatible skills volume
    if [[ -d "$HOME/.claude" ]]; then
        CONFIG_MOUNTS="$CONFIG_MOUNTS -v $HOME/.claude:/home/agent/.claude:ro,z"
    fi

    GUEST_SHARE_PATH="/home/agent/.local/share/opencode"
    STATE_MOUNT="-v abox-state:/home/agent/.local/state/opencode"
else
    if [[ -f "$HOST_CONFIG_PATH" ]]; then
        # If it's a file, mount it to a subfolder and use env var if possible
        GUEST_AUTH_DIR="/home/agent/.config/abox/auth/$EDITOR_NAME"
        CONFIG_MOUNTS="-v $AUTH_VOL:$GUEST_AUTH_DIR"
        case "$EDITOR_NAME" in
            aider) ENV_FLAGS="$ENV_FLAGS -e AIDER_CONFIG=$GUEST_AUTH_DIR/$(basename "$CONFIG_REL_PATH")" ;;
        esac
    else
        CONFIG_MOUNTS="-v $AUTH_VOL:$GUEST_CONFIG_PATH"
    fi
    STATE_MOUNT="-v abox-state-$EDITOR_NAME:/home/agent/.local/state/$EDITOR_NAME"
fi

# Shared Persistent Homebrew volume
CONFIG_MOUNTS="$CONFIG_MOUNTS -v abox-brew:/home/linuxbrew/.linuxbrew"

$CONTAINER_RUNTIME run --rm $INTERACTIVE_FLAGS \
    --name "abox-$EDITOR_NAME-$(basename "$TARGET_DIR")" \
    --hostname abx \
    -e HOST_UID="$HOST_UID" \
    -e HOST_GID="$HOST_GID" \
    $ENV_FLAGS \
    --cap-drop=ALL \
    --cap-add=CHOWN \
    --cap-add=SETUID \
    --cap-add=SETGID \
    --cap-add=DAC_OVERRIDE \
    -v "$TARGET_DIR:/workspace" \
    $CONFIG_MOUNTS \
    -v "$SHARE_VOL:$GUEST_SHARE_PATH" \
    $STATE_MOUNT \
    "$IMAGE_NAME" "$COMMAND_NAME" "$@"
