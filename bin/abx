#!/bin/bash

# ==============================================================================
# ABox - Agnostic Sandbox Runtime
# ==============================================================================

set -o pipefail

# --- Configuration & Defaults ---
ABX_CONF="$HOME/.config/abx.conf"
HOST_UID=${HOST_UID:-$(id -u)}
HOST_GID=${HOST_GID:-$(id -g)}
TIMESTAMP=$(date +%s)

# --- Helper Functions ---

log_error() {
    echo "ERROR: $*" >&2
}

detect_runtime() {
    # 1. Check for explicit override
    if [[ -n "$ABOX_RUNTIME" ]]; then
        if command -v "$ABOX_RUNTIME" >/dev/null 2>&1 && "$ABOX_RUNTIME" info >/dev/null 2>&1; then
            echo "$ABOX_RUNTIME"
            return 0
        fi
        log_error "Specified runtime '$ABOX_RUNTIME' is not available or healthy."
        return 1
    fi

    # 2. Prefer Docker
    if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
        echo "docker"
        return 0
    fi

    # 3. Fallback to Podman
    if command -v podman >/dev/null 2>&1 && podman info >/dev/null 2>&1; then
        echo "podman"
        return 0
    fi

    log_error "No healthy container runtime found (Docker or Podman)."
    log_error "Ensure your container engine is running and accessible."
    return 1
}

# Returns: image_tag|binary_command|config_path|env_vars|legacy_path
get_editor_info() {
    local editor=$1
    case "$editor" in
        claude)   echo "ghcr.io/r-dson/abox:claude|claude|.claude|ANTHROPIC_API_KEY|" ;;
        aider)    echo "ghcr.io/r-dson/abox:aider|aider|.aider.conf.yml|OPENAI_API_KEY,ANTHROPIC_API_KEY|" ;;
        copilot)  echo "ghcr.io/r-dson/abox:copilot|copilot|.copilot|GITHUB_TOKEN|" ;;
        vibe)     echo "ghcr.io/r-dson/abox:vibe|vibe|.vibe||" ;;
        goose)    echo "ghcr.io/r-dson/abox:goose|goose|.config/goose||" ;;
        codex)    echo "ghcr.io/r-dson/abox:codex|codex|.codex||" ;;
        gemini)   echo "ghcr.io/r-dson/abox:gemini|gemini|.gemini|GOOGLE_API_KEY|" ;;
        cursor)   echo "ghcr.io/r-dson/abox:cursor|cursor|.cursor||" ;;
        opencode|*) echo "ghcr.io/r-dson/abox:opencode|opencode|.config/opencode||.opencode" ;;
    esac
}

ensure_host_path_exists() {
    local path="$1"
    local rel_path="$2"

    if [[ ! -e "$path" ]]; then
        # Heuristic: check if it looks like a file (has extension)
        local filename=$(basename "$rel_path")
        if [[ "$filename" == *.* ]] && { [[ "${filename:0:1}" != "." ]] || [[ "$filename" == *.*.* ]]; }; then
            mkdir -p "$(dirname "$path")"
            touch "$path"
        else
            mkdir -p "$path"
        fi
    fi
}

# Sync data from Host -> Container Volume
sync_host_to_vol() {
    local host_path="$1"
    local vol_name="$2"
    local container_path="$3"

    # Skip if host path doesn't exist
    if [[ ! -e "$host_path" ]]; then return; fi
    # Skip if it's an empty directory
    if [[ -d "$host_path" ]] && [[ -z "$(ls -A "$host_path" 2>/dev/null)" ]]; then return; fi

    if [[ -f "$host_path" ]]; then
        # File: cat content into volume
        local filename=$(basename "$host_path")
        cat "$host_path" | $CONTAINER_RUNTIME run --rm -i \
            -v "$vol_name:$container_path" \
            alpine sh -c "cat > $container_path/$filename && chown $HOST_UID:$HOST_GID $container_path/$filename"
    else
        # Directory: tar extract into volume
        tar -C "$host_path" -cf - . 2>/dev/null | $CONTAINER_RUNTIME run --rm -i \
            -v "$vol_name:$container_path" \
            alpine tar -C "$container_path" -xf - 2>/dev/null || true
    fi
}

# Sync data from Container Volume -> Host
sync_vol_to_host() {
    local vol_name="$1"
    local host_path="$2"

    # Handle file vs directory egress
    if [[ -f "$host_path" ]]; then
        local filename=$(basename "$host_path")
        $CONTAINER_RUNTIME run --rm -i \
            -v "$vol_name:/src" \
            alpine cat "/src/$filename" > "$host_path" 2>/dev/null || true
    else
        $CONTAINER_RUNTIME run --rm -i \
            -v "$vol_name:/src" \
            alpine tar -C /src -cf - . 2>/dev/null | tar -C "$host_path" -xf - 2>/dev/null || true
        chown -R "$HOST_UID:$HOST_GID" "$host_path" 2>/dev/null || true
    fi
}

# --- Main Execution ---

# 1. Argument Parsing
CLI_EDITOR=""
CLI_SHELL=false
CLI_IT=false
CLI_OFFLINE=false
SET_DEFAULT=""
POSITIONAL_ARGS=()

while [[ $# -gt 0 ]]; do
    case $1 in
        --editor)           CLI_EDITOR="$2"; shift 2 ;;
        --editor=*)         CLI_EDITOR="${1#*=}"; shift ;;
        --default-editor)   SET_DEFAULT="$2"; shift 2 ;;
        --default-editor=*) SET_DEFAULT="${1#*=}"; shift ;;
        --shell)            CLI_SHELL=true; shift ;;
        --force-it)         CLI_IT=true; shift ;;
        --offline)          CLI_OFFLINE=true; shift ;;
        *)                  POSITIONAL_ARGS+=("$1"); shift ;;
    esac
done

# Handle --default-editor persistence
if [[ -n "$SET_DEFAULT" ]]; then
    mkdir -p "$(dirname "$ABX_CONF")"
    echo "EDITOR=$SET_DEFAULT" > "$ABX_CONF"
    echo "Default editor set to: $SET_DEFAULT"
    # Exit if no execution intended
    if [[ ${#POSITIONAL_ARGS[@]} -eq 0 && -z "$CLI_EDITOR" && "$CLI_SHELL" == "false" && "$CLI_IT" == "false" ]]; then
        exit 0
    fi
fi

# Restore positional args
set -- "${POSITIONAL_ARGS[@]}"

# 2. Resolution: Editor & Runtime
EDITOR_NAME="$CLI_EDITOR"
[[ -z "$EDITOR_NAME" ]] && EDITOR_NAME="$ABOX_EDITOR"
if [[ -z "$EDITOR_NAME" && -f "$ABX_CONF" ]]; then
    EDITOR_NAME=$(grep "^EDITOR=" "$ABX_CONF" | cut -d= -f2)
fi
[[ -z "$EDITOR_NAME" ]] && EDITOR_NAME="opencode"

CONTAINER_RUNTIME=$(detect_runtime) || exit 1
IFS='|' read -r IMAGE_NAME COMMAND_NAME CONFIG_REL_PATH ENV_VAR_NAMES LEGACY_PATH <<< "$(get_editor_info "$EDITOR_NAME")"

# 3. Path & Environment Setup
TARGET_DIR="."
if [[ $# -gt 0 ]] && [[ -d "$1" ]]; then
    TARGET_DIR="$1"
    shift
fi
TARGET_DIR=$(cd "$TARGET_DIR" && pwd)

HOST_CONFIG_PATH="$HOME/$CONFIG_REL_PATH"
HOST_CACHE="$HOME/.cache/$EDITOR_NAME"
HOST_STATE="$HOME/.local/state/$EDITOR_NAME"
HOST_SHARE="$HOME/.local/share/$EDITOR_NAME"

ensure_host_path_exists "$HOST_CONFIG_PATH" "$CONFIG_REL_PATH"
mkdir -p "$HOST_CACHE" "$HOST_STATE" "$HOST_SHARE"

# 4. Volume Lifecycle
VOL_ID="$EDITOR_NAME-$TIMESTAMP"
CONFIG_VOL="abox-config-$VOL_ID"
CACHE_VOL="abox-cache-$VOL_ID"
STATE_VOL="abox-state-$VOL_ID"
SHARE_VOL="abox-share-$VOL_ID"

for vol in "$CONFIG_VOL" "$CACHE_VOL" "$STATE_VOL" "$SHARE_VOL"; do
    $CONTAINER_RUNTIME volume create "$vol" > /dev/null 2>&1
done

cleanup() {
    $CONTAINER_RUNTIME volume rm "$CONFIG_VOL" "$CACHE_VOL" "$STATE_VOL" "$SHARE_VOL" > /dev/null 2>&1
}
trap cleanup EXIT

# Initialize Volume Ownership
$CONTAINER_RUNTIME run --rm \
    -v "$CONFIG_VOL:/config" \
    -v "$CACHE_VOL:/cache" \
    -v "$STATE_VOL:/state" \
    -v "$SHARE_VOL:/share" \
    alpine sh -c "chown -R $HOST_UID:$HOST_GID /config /cache /state /share"

# 5. Sync In (Host -> Container)
echo "Syncing data to sandbox..."
( sync_host_to_vol "$HOST_CONFIG_PATH" "$CONFIG_VOL" "/config" ) &
( sync_host_to_vol "$HOST_CACHE"       "$CACHE_VOL"  "/cache" ) &
( sync_host_to_vol "$HOST_STATE"       "$STATE_VOL"  "/state" ) &
( sync_host_to_vol "$HOST_SHARE"       "$SHARE_VOL"  "/share" ) &
wait

# 6. Prepare & Execute Container
INTERACTIVE_FLAGS="-i"
[[ -t 0 || "$CLI_SHELL" == "true" || "$CLI_IT" == "true" ]] && INTERACTIVE_FLAGS="-it"

EXEC_CMD="$COMMAND_NAME"
[[ "$CLI_SHELL" == "true" ]] && EXEC_CMD="bash"

# Build Env Args
ENV_FLAGS=""
IFS=',' read -ra ADDR <<< "$ENV_VAR_NAMES"
for env_var in "${ADDR[@]}"; do
    [[ -n "${!env_var}" ]] && ENV_FLAGS="$ENV_FLAGS -e $env_var"
done

# Build Mount Args
GUEST_CONFIG_PATH="/home/agent/$CONFIG_REL_PATH"
CONFIG_MOUNTS="-v $CONFIG_VOL:$GUEST_CONFIG_PATH"
[[ -n "$LEGACY_PATH" ]] && CONFIG_MOUNTS="$CONFIG_MOUNTS -v $CONFIG_VOL:/home/agent/$LEGACY_PATH"
CONFIG_MOUNTS="$CONFIG_MOUNTS -v $CACHE_VOL:/home/agent/.cache/$EDITOR_NAME"
CONFIG_MOUNTS="$CONFIG_MOUNTS -v $STATE_VOL:/home/agent/.local/state/$EDITOR_NAME"
CONFIG_MOUNTS="$CONFIG_MOUNTS -v $SHARE_VOL:/home/agent/.local/share/$EDITOR_NAME"

# Global/Shared Mounts
[[ -d "$HOME/.claude" ]] && CONFIG_MOUNTS="$CONFIG_MOUNTS -v $HOME/.claude:/home/agent/.claude:ro,z"
CONFIG_MOUNTS="$CONFIG_MOUNTS -v abox-brew:/home/linuxbrew/.linuxbrew"

# Determine Pull Policy
PULL_POLICY="always"
[[ "$CLI_OFFLINE" == "true" ]] && PULL_POLICY="missing"

# Run
$CONTAINER_RUNTIME run --rm $INTERACTIVE_FLAGS \
    --pull "$PULL_POLICY" \
    --name "abox-$EDITOR_NAME-$(basename "$TARGET_DIR")-$TIMESTAMP" \
    --hostname abx \
    -e HOST_UID="$HOST_UID" \
    -e HOST_GID="$HOST_GID" \
    $ENV_FLAGS \
    --cap-drop=ALL \
    --cap-add=CHOWN \
    --cap-add=SETUID \
    --cap-add=SETGID \
    --cap-add=DAC_OVERRIDE \
    -v "$TARGET_DIR:/workspace" \
    $CONFIG_MOUNTS \
    "$IMAGE_NAME" "$EXEC_CMD" "$@"
EXIT_CODE=$?

# 7. Sync Out (Container -> Host)
echo "Syncing changes back to host..."
( sync_vol_to_host "$CONFIG_VOL" "$HOST_CONFIG_PATH" ) &
( sync_vol_to_host "$CACHE_VOL"  "$HOST_CACHE" ) &
( sync_vol_to_host "$STATE_VOL"  "$HOST_STATE" ) &
( sync_vol_to_host "$SHARE_VOL"  "$HOST_SHARE" ) &
wait


exit $EXIT_CODE
