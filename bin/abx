#!/bin/bash

IMAGE_NAME="ghcr.io/r-dson/abox:main"

# 0. Runtime Detection
detect_runtime() {
    # Check for explicit override
    if [[ -n "$ABOX_RUNTIME" ]]; then
        if command -v "$ABOX_RUNTIME" >/dev/null 2>&1 && "$ABOX_RUNTIME" info >/dev/null 2>&1; then
            echo "$ABOX_RUNTIME"
            return 0
        fi
        echo "ERROR: Specified runtime '$ABOX_RUNTIME' is not available or healthy." >&2
        return 1
    fi

    # Prefer Docker
    if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
        echo "docker"
        return 0
    fi

    # Fallback to Podman
    if command -v podman >/dev/null 2>&1 && podman info >/dev/null 2>&1; then
        echo "podman"
        return 0
    fi

    echo "ERROR: No healthy container runtime found (Docker or Podman)." >&2
    echo "Ensure your container engine is running and accessible." >&2
    return 1
}

CONTAINER_RUNTIME=$(detect_runtime) || exit 1
HOST_CONFIG_DIR="$HOME/.config/opencode"
HOST_SHARE_DIR="$HOME/.local/share/opencode"
HOST_UID=${HOST_UID:-$(id -u)}
HOST_GID=${HOST_GID:-$(id -g)}

# Path Resolution
TARGET_DIR="."
if [[ $# -gt 0 ]] && [[ -d "$1" ]]; then
    TARGET_DIR="$1"
    shift
fi

# Resolve to absolute path
TARGET_DIR=$(cd "$TARGET_DIR" && pwd)

if [[ ! -d "$HOST_CONFIG_DIR" ]]; then
    # echo "WARNING: Host config directory $HOST_CONFIG_DIR does not exist."
    # echo "Creating it now..."
    mkdir -p "$HOST_CONFIG_DIR"
fi

if [[ ! -d "$HOST_SHARE_DIR" ]]; then
    mkdir -p "$HOST_SHARE_DIR"
fi

# 2. Ephemeral Auth/Share Volume Setup
AUTH_VOL="abox-auth-$(date +%s)"
SHARE_VOL="abox-share-$(date +%s)"
$CONTAINER_RUNTIME volume create "$AUTH_VOL" > /dev/null
$CONTAINER_RUNTIME volume create "$SHARE_VOL" > /dev/null

cleanup() {
    $CONTAINER_RUNTIME volume rm "$AUTH_VOL" "$SHARE_VOL" > /dev/null 2>&1
}
trap cleanup EXIT

# 3. Copy Auth Keys to Airlock (Permission Normalization)
# We use :ro,z to handle SELinux on systems like Fedora/Bazzite
$CONTAINER_RUNTIME run --rm \
    -v "$HOST_CONFIG_DIR:/config_src:ro,z" \
    -v "$HOST_SHARE_DIR:/share_src:ro,z" \
    -v "$AUTH_VOL:/config_dest" \
    -v "$SHARE_VOL:/share_dest" \
    alpine sh -c "
        cp -r /config_src/. /config_dest/ && 
        cp -r /share_src/. /share_dest/ && 
        chmod -R u+rwX /config_dest /share_dest && 
        chown -R $HOST_UID:$HOST_GID /config_dest /share_dest
    "

# 4. Launch Sandbox
INTERACTIVE_FLAGS="-i"
if [[ -t 0 ]]; then
    INTERACTIVE_FLAGS="-it"
fi

$CONTAINER_RUNTIME run --rm $INTERACTIVE_FLAGS \
    --name "abox-$(basename "$TARGET_DIR")" \
    --hostname abx \
    -e HOST_UID="$HOST_UID" \
    -e HOST_GID="$HOST_GID" \
    --cap-drop=ALL \
    --cap-add=CHOWN \
    --cap-add=SETUID \
    --cap-add=SETGID \
    --cap-add=DAC_OVERRIDE \
    -v "$TARGET_DIR:/workspace" \
    -v "$AUTH_VOL:/home/agent/.config/opencode" \
    -v "$AUTH_VOL:/home/agent/.opencode" \
    -v "$SHARE_VOL:/home/agent/.local/share/opencode" \
    -v "abox-state:/home/agent/.local/state/opencode" \
    "$IMAGE_NAME" opencode "$@"
