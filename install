#!/bin/bash
set -e

# ABox Installation Script
# Usage: curl -fsSL https://raw.githubusercontent.com/R-Dson/ABox/main/install | bash
#
# Downloads a static Go binary — no runtime dependencies needed.
# Editor registry is embedded in the binary.

REPO="R-Dson/ABox"
BINARY_NAME="abx"

echo "ABox Installation"
echo "-------------------"

# Detect platform
OS="$(uname -s | tr '[:upper:]' '[:lower:]')"
ARCH="$(uname -m)"
case "$ARCH" in
    x86_64)  ARCH="amd64" ;;
    aarch64) ARCH="arm64" ;;
    arm64)   ARCH="arm64" ;;
    *)       echo "Error: unsupported architecture $ARCH"; exit 1 ;;
esac

if [ "$OS" != "linux" ] && [ "$OS" != "darwin" ]; then
    echo "Error: unsupported OS $OS (supported: linux, darwin)"
    exit 1
fi

ARTIFACT="${BINARY_NAME}_${OS}_${ARCH}.tar.gz"
RELEASE_URL="https://github.com/$REPO/releases/latest/download/$ARTIFACT"
CHECKSUM_URL="https://github.com/$REPO/releases/latest/download/checksums.txt"

# Ask for installation type
if [ -t 0 ] || [ -c /dev/tty ]; then
    read -rp "Install system-wide (/usr/local/bin)? [Y/n]: " choice < /dev/tty || choice="Y"
else
    choice="Y"
fi
choice=${choice:-Y}

case $choice in
    [Yy]*)
        INSTALL_DIR="/usr/local/bin"
        USE_SUDO=true
        ;;
    [Nn]*)
        INSTALL_DIR="$HOME/.local/bin"
        USE_SUDO=false
        mkdir -p "$INSTALL_DIR"
        ;;
    *)
        echo "Invalid option. Defaulting to user-local (~/.local/bin)."
        INSTALL_DIR="$HOME/.local/bin"
        USE_SUDO=false
        mkdir -p "$INSTALL_DIR"
        ;;
esac

TMPDIR="$(mktemp -d)"
trap 'rm -rf "$TMPDIR"' EXIT

# Download binary archive
echo "Downloading $ARTIFACT..."
if ! curl -fsSL "$RELEASE_URL" -o "$TMPDIR/$ARTIFACT"; then
    echo "Error: Failed to download abx."
    echo "Please check that a release exists at: $RELEASE_URL"
    exit 1
fi

# Verify SHA-256 checksum
echo "Verifying integrity..."
if curl -fsSL "$CHECKSUM_URL" -o "$TMPDIR/checksums.txt" 2>/dev/null; then
    EXPECTED="$(grep "$ARTIFACT" "$TMPDIR/checksums.txt" | cut -d' ' -f1)"
    ACTUAL="$(sha256sum "$TMPDIR/$ARTIFACT" | cut -d' ' -f1)"
    if [ "$EXPECTED" != "$ACTUAL" ]; then
        echo "Error: SHA-256 verification failed."
        echo "Expected: $EXPECTED"
        echo "Actual:   $ACTUAL"
        exit 1
    fi
    echo "Integrity verified."
else
    echo "Warning: Checksum not available. Skipping integrity verification."
fi

# Extract and install
tar -xzf "$TMPDIR/$ARTIFACT" -C "$TMPDIR" "$BINARY_NAME"
chmod +x "$TMPDIR/$BINARY_NAME"

echo "Installing to $INSTALL_DIR..."
if [ "$USE_SUDO" = true ] && [ ! -w "$INSTALL_DIR" ]; then
    sudo mv "$TMPDIR/$BINARY_NAME" "$INSTALL_DIR/$BINARY_NAME"
else
    mv "$TMPDIR/$BINARY_NAME" "$INSTALL_DIR/$BINARY_NAME"
fi

echo ""
echo "ABox has been installed successfully!"

# Verify PATH
if [[ ":$PATH:" != *":$INSTALL_DIR:"* ]]; then
    echo ""
    echo "WARNING: $INSTALL_DIR is not in your PATH."
    echo "Add it to your shell configuration:"
    echo "  export PATH=\"\$PATH:$INSTALL_DIR\""
fi

echo "Run 'abx' to start."
